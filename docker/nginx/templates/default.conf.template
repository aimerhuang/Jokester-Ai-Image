# 由 nginx 官方镜像在启动时用环境变量渲染：API_UPSTREAM、NGINX_RESOLVER、APP_DOMAIN、
# TLS_MODE(on/off)、REAL_IP_MODE(none/cloudflare)、CLIENT_MAX_BODY_SIZE、PROXY_READ_TIMEOUT。
# nginx 自身的 $变量 不受影响。

resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

# resolve 让 API 容器重建、IP 变化后无需重启 web 容器。
upstream jokester_api {
    zone jokester_api 64k;
    server ${API_UPSTREAM} resolve;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    include /etc/nginx/snippets/realip-${REAL_IP_MODE}.conf;

    if ($host = www.${APP_DOMAIN}) {
        return 301 $scheme://${APP_DOMAIN}$request_uri;
    }

    include /etc/nginx/snippets/tls-${TLS_MODE}.conf;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # API 只信任本容器 IP，且 ForwardLimit=1；这里覆盖而不是追加客户端传入的值。
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_send_timeout ${PROXY_READ_TIMEOUT};
    proxy_read_timeout ${PROXY_READ_TIMEOUT};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 与 vite 开发代理保持一致：/api/avatar/* -> /avatar/*
    location ^~ /api/avatar/ {
        rewrite ^/api(/avatar/.*)$ $1 break;
        proxy_pass http://jokester_api;
    }

    location ^~ /api/ {
        proxy_pass http://jokester_api;
    }

    location ^~ /avatar/ {
        proxy_pass http://jokester_api;
    }

    location ^~ /blog/ {
        proxy_pass http://jokester_api;
    }

    location ^~ /prompt-images/ {
        proxy_pass http://jokester_api;
    }

    location ^~ /swagger {
        proxy_pass http://jokester_api;
    }

    location ^~ /assets/ {
        include /etc/nginx/snippets/static-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/static-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        include /etc/nginx/snippets/static-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
